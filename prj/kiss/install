cd $(dirname ${BASH_SOURCE[0]})
this=$PWD/$(basename ${BASH_SOURCE[0]})
here=$PWD
lbin=${BCH0_BIN:-$HOME/.local/bin}

mkdir -p $lbin

this0=\$HOME${this:${#HOME}}
here0=\$HOME${here:${#HOME}}
lbin0=\$HOME${lbin:${#HOME}}

source $here/.init/init.sh

clr_bold "[$this0]"
clr_bold "   <here> = $here0"
clr_bold "   <lbin> = $lbin0"


for name in kiss; do
    real=$here/$name
    link=$lbin/$name
    clr_bold "   ln -s <here>/$name <lbin>/$name"
    [ -L $link ] && rm $link
    ln -s $real $link
done

