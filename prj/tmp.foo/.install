cd $(dirname ${BASH_SOURCE[0]})
source $PWD/.sys/vendor.d/bash_colors.sh
real=$PWD/.main.sh
name=$(basename $PWD)
link=~/.local/bin/$name
rm $link 2> /dev/null
clr_bold "ln -s $real $link"
ln -s $real $link
$name my repo install
$name my bucket install
exit
mklink () {
    local real=$1
    local link=$2
    [ ! -e $real ] && mkdir -p $real
    clr_bold "ln -s $real $link"
    ln -s $real $link
}



mklink $PWD/main.sh ~/.local/bin/$name

