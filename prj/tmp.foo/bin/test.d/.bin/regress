#!/usr/bin/env bash
$__init__

cmd="$1" ; shift
cmdBold=$(clr_bold "$cmd")
name=$(basename ${BASH_SOURCE[1]})
output=$my_testd/.regress
mkdir -p ${output}
exp=$output/$name.exp
got=$output/$name.got
$cmd > $got
[ ! -f $exp ] && cp $got $exp
cmp $exp $got
err=$?
[   $err == 0 ] && . _pass $name "(regress $cmdBold)" 
[ ! $err == 0 ] && . _fail $name "(regress $cmdBold)" 
return $err

