#!/usr/bin/env bash
$__init__
if [ ! "${my_repo:0:3}" == "tmp" ]; then
    echo not a tmp repo. Not deleting
    exit
fi
clr_bold "removing local repo ..."
[ -e $my_repo_local ] && echo removing local
[ -e $my_repo_local ] && rm -rf $my_repo_local
[ -e $my_repo_local ] && clr_bold "removing local failed"

clr_bold "deleting remote repo"
gh repo delete $my_repo
