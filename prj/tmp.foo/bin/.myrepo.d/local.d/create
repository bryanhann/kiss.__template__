#!/usr/bin/env bash
$__init__
. header  $*

exists() { $my_name .myrepo local exists ;}
errors() { clr_bold "there were errors. does the remote exist?" ; }
#boldrun () { clr_bold "$ $@" ; $@ ; }
clone () { gh repo clone $my_repo $my_repo_local ; }

if ! exists ; then
    clone || errors
fi

if exists; then
    pushd $my_repo_local > /dev/null
    git log --oneline || { 
        touch hello
        git add ./hello
        git commit -m initial-commit
        #git commit -m 'initial commit'
    }
    popd >/dev/null
fi

exists
