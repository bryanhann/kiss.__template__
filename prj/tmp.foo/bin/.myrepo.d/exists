#!/usr/bin/env bash
$__init__
. header $*

$my_name .myrepo local exists  && isL=true || isL=false

$my_name .myrepo remote exists && isR=true || isR=false

ret=err
[ $isL == true  ] && [ $isR == true  ] && ret=true
[ $isL == false ] && [ $isR == false ] && ret=false

. header $*
echo $ret
[ $ret == true ]
