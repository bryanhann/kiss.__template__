#!/usr/bin/env bash

[ ! -d $my_repo_local ] &&  gh repo clone  $my_repo $my_repo_local
[ ! -d $my_repo_local ] &&  gh repo create $my_repo --private
[ ! -d $my_repo_local ] &&  gh repo clone  $my_repo $my_repo_local

$my repo stat-isempty && {
    pushd $my_repo_local
    touch log
    git add log
    git commit -m 'initial commit'
    git push
    git log
    popd > /dev/null
} || {
    echo not empty
}

