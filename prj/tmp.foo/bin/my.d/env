$__init__

dump () {
    for line in $(         \
        set                \
        | sort             \
        | grep ^my_        \
        | grep -v callback \
        | grep -v ^my_fin  \
        | grep -v ^my_dot  \
    );
    do
        name="$(echo $line | cut -d'=' -f1 )                 "
        val=$(echo $line | cut -d'=' -f2 )             
        [ "$my_root" == "${val:0:${#my_root}}" ] && val=[REPO]${val:${#my_root}}  
        [ "$HOME"    == "${val:0:${#HOME}}"    ] && val=[REPO]${val:${#HOME}}     
        echo "${name:0:20}" - $val
    done
}

dump
