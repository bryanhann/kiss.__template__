#!/usr/bin/env bash
$__init__
. header $*
$my bucket exists || {
    clr_bold "cannot sync nonexistant bucket"
    exit
}
local=$my_bucket_local
remote=$my_bucket_remote
clr_bold "touching local/random ..."
echo $RANDOM > $local/random
cd $(dirname $local)
clr_bold "syncing..."
aws s3 sync $local $remote

