#!/usr/bin/env bash
$__init__
. header $*

local=$my_bucket_local
remote=$my_bucket_remote

$my_name .mybucket local exists && exit

mkdir -p $local
echo $RANDOM > $my_bucket_local/random

$my_name .mybucket sync > /dev/null 2> /dev/null || {
    rm -rf $my_bucket_local
}
$my_name .mybucket local exists 

