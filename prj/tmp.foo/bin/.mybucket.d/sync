#!/usr/bin/env bash
$__init__
.  header $*

local=$my_bucket_local
remote=$my_bucket_remote
cd $(dirname $local)

clr_bold "touching local/random"
echo $RANDOM > $my_bucket_local/random

clr_bold "$ aws s3 sync $local $remote"
            aws s3 sync $local $remote || {
    clr_bold "Cannot sync. Does remote exist?"
    exit 1
}

exit 0
