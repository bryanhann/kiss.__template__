cd $(dirname $0)
source $PWD/.sys/_vendor
this=$PWD/$(basename $0)
repo=$(dirname $(dirname $PWD))
clr_bold "[$(basename $repo)]${this:${#repo}}"
LBIN=~/.local/bin
name=$(basename $PWD)

real=$PWD/main.sh
link=$LBIN/$name

REAL=[$(basename $repo)]${real:${#repo}}
LINK=[LBIN]${link:${#LBIN}}
#clr_bold "$LINK ==> $REAL"

rm $link 2> /dev/null
ln -s $real $link

